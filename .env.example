# Adaptive AI Cyber Defense System — example environment configuration.
# Copy to `.env` and adjust. Do NOT commit real secrets or a real .env file.

# --- Application ---
APP_ENV=development                 # development | production

# --- Database ---
# SQLite path (default). On some cloud platforms disk is EPHEMERAL — see docs.
DATABASE_PATH=data/soc.db
# Optional URL form (sqlite:///absolute/path/soc.db). Postgres URLs are reserved
# for a future migration and are not yet used by the app.
# DATABASE_URL=sqlite:///data/soc.db

# --- Safety (KEEP THESE DEFAULTS for the M.Tech project) ---
RESPONSE_SIMULATION=true             # responses are always simulated
AUTO_RESPONSE=false                  # never auto-execute real actions
AUTONOMY_LEVEL_CAP=3                 # max autonomy level the system may use

# --- Threat intelligence ---
EXTERNAL_TI_ENABLED=false            # external CTI providers not configured

# --- Real datasets ---
# Directory where you place real CIC-IDS2017 / CSE-CIC-IDS2018 CSV files.
DATASET_DIR=data/datasets

# --- Server / deployment ---
HOST=0.0.0.0                         # bind all interfaces in production
PORT=8000                            # cloud platforms inject $PORT automatically
CORS_ORIGINS=*                       # comma-separated allowed origins

# --- Limits ---
MAX_EVENTS=50000
MAX_UPLOAD_BYTES=26214400
